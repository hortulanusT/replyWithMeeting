[
    {
        "namespace": "calendarDialog",
        "description": "Opens the Thunderbird native calendar event dialog.",
        "functions": [
            {
                "name": "buildReplyHeader",
                "type": "function",
                "description": "Builds a localized Thunderbird-style reply header string.",
                "async": true,
                "parameters": [
                    {
                        "name": "options",
                        "type": "object",
                        "properties": {
                            "author": {
                                "type": "string",
                                "description": "Original message author string."
                            },
                            "dateEpochMs": {
                                "type": "number",
                                "description": "Original message date as Unix epoch milliseconds."
                            }
                        }
                    }
                ]
            },
            {
                "name": "openNewEventDialog",
                "type": "function",
                "description": "Opens the Thunderbird calendar event editor pre-populated with meeting data.",
                "async": true,
                "parameters": [
                    {
                        "name": "options",
                        "type": "object",
                        "properties": {
                            "summary": {
                                "type": "string",
                                "description": "Meeting title."
                            },
                            "description": {
                                "type": "string",
                                "description": "Notes pre-filled in the event body."
                            },
                            "attendees": {
                                "type": "array",
                                "description": "List of invitees.",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "email": {
                                            "type": "string"
                                        },
                                        "name": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "startTime": {
                                "type": "string",
                                "description": "Default start time as ISO datetime string."
                            },
                            "endTime": {
                                "type": "string",
                                "description": "Default end time as ISO datetime string."
                            },
                            "strings": {
                                "type": "object",
                                "optional": true,
                                "description": "Localized user-facing messages used by the experiment.",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "optional": true
                                    },
                                    "noWritableCalendar": {
                                        "type": "string",
                                        "optional": true
                                    },
                                    "saveFailed": {
                                        "type": "string",
                                        "optional": true
                                    },
                                    "invitationsNotSent": {
                                        "type": "string",
                                        "optional": true
                                    }
                                }
                            }
                        }
                    }
                ]
            }
        ]
    }
]